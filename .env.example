# Lakebase (Postgres) — variable names only; values come from env / Databricks
# secrets. The Lakebase password is a short-lived OAuth token minted on demand by
# db/lakebase.py via the `databricks` CLI — never set it here, never commit it.
# LAKEBASE_INSTANCE=evangoh-capstone-lakebase
# LAKEBASE_HOST=ep-steep-truth-d1ex36nr.database.us-west-2.cloud.databricks.com
# LAKEBASE_PORT=5432
# LAKEBASE_DBNAME=databricks_postgres
# LAKEBASE_USER=you@example.com
# LAKEBASE_SCHEMA=public
# LAKEBASE_SSLMODE=require
# LAKEBASE_CONNECT_TIMEOUT=10
# LAKEBASE_POOL_MIN_SIZE=1
# LAKEBASE_POOL_MAX_SIZE=5
# LAKEBASE_TOKEN_REFRESH_MARGIN=300

# Risk limits (agent/guardrails.py)
# MAX_ORDER_NOTIONAL=25000
# MAX_POSITION_NOTIONAL=50000
# STALE_SIGNAL_MINUTES=5
