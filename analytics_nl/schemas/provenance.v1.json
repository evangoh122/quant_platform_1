{
  "$defs": {
    "CacheStatus": {
      "description": "Cache status for provenance envelopes.",
      "enum": [
        "hit",
        "miss",
        "bypass"
      ],
      "title": "CacheStatus",
      "type": "string"
    },
    "CanonicalIntent": {
      "additionalProperties": false,
      "description": "Resolved canonical intent — all entities are canonical IDs.",
      "properties": {
        "date_range": {
          "$ref": "#/$defs/DateRange"
        },
        "entities": {
          "items": {
            "discriminator": {
              "mapping": {
                "index": "#/$defs/IndexEntity",
                "sector": "#/$defs/SectorEntity",
                "ticker": "#/$defs/TickerEntity"
              },
              "propertyName": "entity_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TickerEntity"
              },
              {
                "$ref": "#/$defs/SectorEntity"
              },
              {
                "$ref": "#/$defs/IndexEntity"
              }
            ]
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Entities",
          "type": "array"
        },
        "grouping": {
          "$ref": "#/$defs/Grouping"
        },
        "limit": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Limit",
          "type": "integer"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "semantic_model_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Semantic Model Version",
          "type": "string"
        }
      },
      "required": [
        "semantic_model_version",
        "operation",
        "metric",
        "entities",
        "date_range",
        "grouping",
        "limit"
      ],
      "title": "CanonicalIntent",
      "type": "object"
    },
    "CostClass": {
      "description": "Policy cost classification.",
      "enum": [
        "CHEAP",
        "NORMAL",
        "EXPENSIVE",
        "REJECT"
      ],
      "title": "CostClass",
      "type": "string"
    },
    "DateRange": {
      "additionalProperties": false,
      "description": "Inclusive date range with start <= end.",
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "Grouping": {
      "description": "Allowed grouping values (daily-or-coarser).",
      "enum": [
        "day",
        "week",
        "month",
        "quarter",
        "year",
        "ticker",
        "sector"
      ],
      "title": "Grouping",
      "type": "string"
    },
    "IndexEntity": {
      "additionalProperties": false,
      "description": "Canonical index reference.",
      "properties": {
        "canonical_id": {
          "maxLength": 10,
          "minLength": 1,
          "title": "Canonical Id",
          "type": "string"
        },
        "entity_type": {
          "const": "index",
          "default": "index",
          "title": "Entity Type",
          "type": "string"
        }
      },
      "required": [
        "canonical_id"
      ],
      "title": "IndexEntity",
      "type": "object"
    },
    "Metric": {
      "description": "Supported analytics metrics.  Market capitalization is intentionally\nexcluded because there is no governed shares-outstanding source.",
      "enum": [
        "price",
        "return",
        "volume",
        "realized_volatility",
        "drawdown",
        "momentum",
        "relative_performance",
        "implied_volatility",
        "put_call_ratio"
      ],
      "title": "Metric",
      "type": "string"
    },
    "Operation": {
      "description": "Supported analytics operations.",
      "enum": [
        "trend",
        "compare",
        "rank",
        "aggregate"
      ],
      "title": "Operation",
      "type": "string"
    },
    "SectorEntity": {
      "additionalProperties": false,
      "description": "Canonical sector reference.",
      "properties": {
        "canonical_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Canonical Id",
          "type": "string"
        },
        "entity_type": {
          "const": "sector",
          "default": "sector",
          "title": "Entity Type",
          "type": "string"
        }
      },
      "required": [
        "canonical_id"
      ],
      "title": "SectorEntity",
      "type": "object"
    },
    "TickerEntity": {
      "additionalProperties": false,
      "description": "Canonical ticker reference.",
      "properties": {
        "canonical_id": {
          "maxLength": 10,
          "minLength": 1,
          "title": "Canonical Id",
          "type": "string"
        },
        "entity_type": {
          "const": "ticker",
          "default": "ticker",
          "title": "Entity Type",
          "type": "string"
        }
      },
      "required": [
        "canonical_id"
      ],
      "title": "TickerEntity",
      "type": "object"
    }
  },
  "$id": "https://analytics-nl/schemas/nl1-provenance-envelope-schema",
  "additionalProperties": false,
  "description": "Provenance record for executed queries.",
  "properties": {
    "cache_status": {
      "$ref": "#/$defs/CacheStatus"
    },
    "cost_class": {
      "$ref": "#/$defs/CostClass"
    },
    "dataset_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/CanonicalIntent"
    },
    "policy_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "rows": {
      "minimum": 0,
      "title": "Rows",
      "type": "integer"
    },
    "runtime_ms": {
      "minimum": 0,
      "title": "Runtime Ms",
      "type": "number"
    },
    "sanitized_sql": {
      "maxLength": 50000,
      "minLength": 1,
      "title": "Sanitized Sql",
      "type": "string"
    },
    "semantic_model_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Semantic Model Version",
      "type": "string"
    },
    "statement_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Statement Id",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "statement_id",
    "sanitized_sql",
    "intent",
    "semantic_model_version",
    "dataset_version",
    "policy_version",
    "cost_class",
    "rows",
    "runtime_ms",
    "cache_status",
    "trace_id"
  ],
  "title": "NL1 Provenance Envelope Schema",
  "type": "object"
}
